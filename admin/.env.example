PORT=8080
HOST=localhost
LOG_LEVEL=info
# Opcional: substitui a URL usada para testar a conectividade com a internet.
# O padrão é https://1.1.1.1/cdn-cgi/trace, com alternativas em hosts que o aplicativo
# já acessa. Deixe sem definir para usar os valores padrão.
# INTERNET_STATUS_TEST_URL=https://1.1.1.1/cdn-cgi/trace
APP_KEY=some_random_key
NODE_ENV=development
SESSION_DRIVER=cookie
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_DATABASE=nomad
DB_PASSWORD=password
DB_SSL=false
REDIS_HOST=localhost
REDIS_PORT=6379
# Opcional: índice do banco de dados lógico do Redis (0-15). O padrão é 0 se não for definido.
# Defina este valor ao compartilhar uma instância do Redis entre serviços para evitar conflitos de chaves.
# REDIS_DB=0
# Caminho de armazenamento do conteúdo do NOMAD (arquivos ZIM, mapas etc.).
# No ambiente de desenvolvimento Windows, use um caminho absoluto, como: C:/nomad-storage
# Em produção Linux, use: /opt/project-nomad/storage
NOMAD_STORAGE_PATH=/opt/project-nomad/storage
# Pacotes de criadores (downloads de conteúdo com acesso restrito).
# As versões oficiais de lançamento definem CREATOR_PACKS_APP_KEY durante a compilação;
# deixe sem definir para uma compilação que não possa instalar pacotes.
# CREATOR_PACKS_WORKER_BASE substitui a origem do Worker responsável pelas permissões de acesso.
# CREATOR_PACKS_APP_KEY=
# CREATOR_PACKS_WORKER_BASE=https://nomad-packs-worker.chris-556.workers.dev
